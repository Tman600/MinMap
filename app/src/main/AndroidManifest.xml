<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Installs its own updates from GitHub releases (see AppUpdates). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Drive mode follows the driver's position on the map. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- A brief "Back to your map" bubble over Google Maps; Android only lets an app return to the
         front from the background while it has a window showing. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- The live next-turn chip in the status bar while driving (a promoted "Live Update"). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <!-- The Google Maps navigation intent is matched by package, so Maps must be visible to us. -->
    <queries>
        <package android:name="com.google.android.apps.maps" />
        <!-- Robotaxi rider apps, opened from the buttons next to Drive. -->
        <package android:name="com.waymo.carapp" />
        <package android:name="com.tesla.riders" />
        <package android:name="com.zoox.android.ride" />
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MapStyleEditor">

        <!-- Folding/unfolding or rotating is handled in Compose, so a drive in progress isn't torn down. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Reads Google Maps' turn-by-turn notification (only that one) for drive mode. -->
        <receiver
            android:name=".update.UpdateInstallReceiver"
            android:exported="false" />

        <service
            android:name=".nav.GoogleNavListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
